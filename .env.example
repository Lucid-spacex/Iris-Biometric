# ==============================================================================
# IRIS BIOMETRIC DEMO - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' (in the deploy folder) and fill in your values.
#
# 1. NEON POSTGRES DATABASE URL:
#    - Sign up at https://neon.tech (free tier).
#    - Create a project (e.g. 'iris-biometric-db').
#    - Copy your Connection String from the Neon dashboard.
#    - Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
#
DATABASE_URL=postgresql://neondb_owner:npg_xxxxxxxxxxxx@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. AES-256 MASTER KEY (OPTIONAL BUT RECOMMENDED FOR PERSISTENCE):
#    - 64 hexadecimal characters representing a 256-bit AES secret key.
#    - Keeps the gallery decryptable across server restarts.
#    - Generate one easily in Python:
#        python -c "import secrets; print(secrets.token_hex(32))"
#
AES_MASTER_KEY_HEX=

# 3. KAGGLE CREDENTIALS (OPTIONAL, FOR DATASET DOWNLOAD):
#    - From https://www.kaggle.com/settings/api (Generate New Token)
# KAGGLE_USERNAME=
# KAGGLE_KEY=
